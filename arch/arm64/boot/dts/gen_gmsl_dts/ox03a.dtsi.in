				0x3501 0x01 0x3502 0x90
			>;
{% if ad_gain %}
			nv,gain-type = "ad";

			nv,again-min = <16>;
			nv,again-max = <248>;
			nv,again-regs = <0x3508 0x3509>;
			nv,again-source-masks = <0xf0 0x0f>;
			nv,again-target-masks = <0x0f 0xf0>;

			nv,dgain-min = <1024>;
			nv,dgain-max = <16383>;
			nv,dgain-regs = <0x350a 0x350b 0x350c>;
			nv,dgain-source-masks = <0x3c00 0x3fc 0x3>;
			nv,dgain-target-masks = <0x0f 0xff 0xc000>;
{% else %}
			nv,gain-type = "simple";
			nv,gain-regs = <0x3508 0x3509>;
			nv,gain-source-masks = <0xf0 0x0f>;
			nv,gain-target-masks = <0x0f 0xf0>;
{% endif %}

			mclk_khz = "25000";
			num_lanes = "4";
			tegra_sinterface = "{{ tegra_sinterface }}";
			vc_id = "{{ ser_idx }}";
			phy_mode = "DPHY";
			discontinuous_clk = "no";
			dpcm_enable = "false";
			cil_settletime = "0";
{% if platform_cfg.lane_polarity is defined %}
			lane_polarity = "{{ platform_cfg.lane_polarity }}";
{% endif %}

			active_w = "1920";
			active_h = "1280";
			mode_type = "bayer";
			pixel_phase = "bggr";
			csi_pixel_bit_depth = "12";
			readout_orientation = "0";
			line_length = "1920";
			inherent_gain = "1";
			mclk_multiplier = "10";
			pix_clk_hz = "250000000";

{% if ad_gain %}
			gain_factor = "16384";
			min_gain_val = "16384";
			max_gain_val = "4062984";
			step_gain_val = "1";
			default_gain = "16384";
{% else %}
			gain_factor = "16";
			min_gain_val = "16";
			max_gain_val = "248";
			step_gain_val = "1";
			default_gain = "16";
{% endif %}
			min_hdr_ratio = "1";
			max_hdr_ratio = "1";

			framerate_factor = "1000000";
			min_framerate = "30000000";
			max_framerate = "30000000";
			step_framerate = "1";
			default_framerate = "30000000";

			exposure_factor = "1000000";
			min_exp_time = "13";
			max_exp_time = "683709";
			step_exp_time = "1";
			default_exp_time = "2495";

			embedded_metadata_height = "0";

			serdes_link_freq = "{{ link_freq }}";
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				{{ cam_out }}: endpoint {
					remote-endpoint = <&{{ ser_ch_in }}>;
					port-index = <{{ tegra_port }}>;
					bus-width = <{{ num_lanes }}>;
					data-lanes = <1 2 3 4>;
					clock-lanes = <0>;
				};
			};
		};
	};
};

{# --- Serializer pipe and pin configuration for OX03A --- #}
{% set des_label = 'des' %}
{% set phy_cfg = des_cfg.phys[0] %}
{% set phy_idx = phy_cfg.phy_idx %}

&{{ ser_label }} {
	pipe@0 {
		maxim,dbl12;
		maxim,soft-bpp = <24>;
	};

	pins {
		{{ pwdn_label }}: ser_{{ ser_idx }}_mfp{{ pwdn_pin }}_pwdn {
			pins = "mfp{{ pwdn_pin }}";
			function = "gpio";
			bias-pull-up;
		};

		{{ rclk_label }}: ser_{{ ser_idx }}_mfp{{ rclk_pin }}_rclk {
			pins = "mfp{{ rclk_pin }}";
			function = "rclkout";
			slew-rate = <0>;
			maxim,rclkout-clock = <0>;
		};
	};
};

{# --- Deserializer PHY memory map --- #}
&{{ des_label }} {
	phy@{{ phy_idx }} {
		maxim,alt-mem-map12;
	};
};
