{% set cam_label = cam_label_x(ser_idx) %}
{% set cam_out = cam_out_label_x(ser_idx) %}
{% set ser_label = ser_label_x(ser_idx) %}
{% set ser_i2c = ser_i2c_label_x(ser_idx) %}
{% set ser_ch_in = ser_ch_in_label_x(ser_idx) %}
{% set pwdn_pin = cam_cfg.pwdn_pin | d(0) %}
{% set rclk_pin = cam_cfg.rclk_pin | d(4) %}
{% set tegra_sinterface = platform_cfg.tegra_sinterface | d('serial_e') %}
{% set tegra_port = platform_cfg.tegra_port | d(4) %}
{% set phy_cfg = des_cfg.phys[0] %}
{% set num_lanes = phy_cfg.num_lanes | d(4) %}
{% set link_freq = phy_cfg.link_frequencies[0] %}
{% set ad_gain = cam_cfg.ad_gain | d(false) %}
{% set pwdn_label = ser_label ~ '_mfp' ~ pwdn_pin ~ '_pwdn' %}
{% set rclk_label = ser_label ~ '_mfp' ~ rclk_pin ~ '_rclk' %}

&{{ ser_i2c }} {
	{{ cam_label }}: ox03a@36 {
		#address-cells = <1>;
		#size-cells = <0>;

		compatible = "nv,nv-cam";
		reg = <0x36>;
		label = "{{ cam_label }}";

		pinctrl-0 = <&{{ pwdn_label }} &{{ rclk_label }}>;
		pinctrl-names = "default";

		pwdn-gpios = <&{{ ser_label }} {{ pwdn_pin }} 0>;
		nv,pwdn-sleep-us = <500000>;

		physical_w = "3.680";
		physical_h = "2.760";
		sensor_model = "ox03a";
		use_sensor_mode_id = "true";

		nv,reg-bits = <16>;
		nv,val-bits = <8>;
		nv,chip-id-regs = <0x300a 0x300b>;
		nv,chip-id-masks = <0xff 0xff>;
		nv,chip-id-vals = <0x58 0x03>;
		nv,wait-ms-cmd = <0>;
		nv,mode-common-cmd = <0x100 0x00 0x103 0x01 0x00 0x0a>;
		nv,start-stream-cmd = <0x100 0x01 0x00 0x03>;
		nv,stop-stream-cmd = <0x100 0x00>;

		mode0 {
			nv,mode-cmd = <
				0x4d07 0x21 0x4d0e 0x80 0x4d11 0x7d
				0x303 0x02 0x305 0x30 0x306 0x03 0x307 0x01
